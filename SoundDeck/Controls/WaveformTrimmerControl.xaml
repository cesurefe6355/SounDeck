<UserControl x:Class="SoundDeck.Controls.WaveformTrimmerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="220" d:DesignWidth="540">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Waveform and selection container -->
        <Border Grid.Row="0"
                x:Name="WaveformBorder"
                Height="145"
                Background="#0F1218"
                BorderBrush="#252A36"
                BorderThickness="1"
                CornerRadius="8"
                ClipToBounds="True"
                Focusable="True">
            <Grid x:Name="WaveformGrid">
                <!-- Direct Drawing Canvas -->
                <Canvas x:Name="OverlayCanvas" Background="Transparent" />

                <!-- Floating time badge -->
                <Border x:Name="TimeBadge"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Margin="0,8,0,0"
                        Padding="6,3"
                        Background="#FFC820"
                        CornerRadius="4"
                        IsHitTestVisible="False"
                        Visibility="Collapsed">
                    <TextBlock x:Name="TimeBadgeText"
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="#0F1218"
                               Text="00:00.00" />
                </Border>
            </Grid>
        </Border>

        <!-- Playback button and quick info below waveform -->
        <Grid Grid.Row="1" Margin="0,12,0,0">
            <!-- Centered Play/Pause Button -->
            <Button x:Name="PlayButton"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Width="44"
                    Height="44"
                    Click="PlayButton_Click"
                    Cursor="Hand"
                    ToolTip="Seçili aralığı dinle / durdur">
                <Button.Template>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="BtnRoot"
                                Width="44"
                                Height="44"
                                Background="#1A202C"
                                BorderBrush="#2F3646"
                                BorderThickness="1"
                                CornerRadius="22"
                                SnapsToDevicePixels="True">
                            <TextBlock x:Name="BtnIcon"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontFamily="{StaticResource IconFont}"
                                       FontSize="15"
                                       Foreground="#E2E8F0"
                                       Margin="2,0,0,0"
                                       Text="&#xE768;" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnRoot" Property="Background" Value="#2A3245" />
                                <Setter TargetName="BtnRoot" Property="BorderBrush" Value="#FFC820" />
                                <Setter TargetName="BtnIcon" Property="Foreground" Value="#FFC820" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnRoot" Property="Background" Value="#151A24" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>
    </Grid>
</UserControl>
